<entity-mappings xmlns="http://java.sun.com/xml/ns/persistence/orm" version="2.0">
    <!-- Events now live in Axon Server, so the JPA event-store mapping is gone.
         The token store stays on PostgreSQL - the connector ships no TokenStore -
         and still needs its BYTEA override. -->
    <entity class="org.axonframework.messaging.eventhandling.processing.streaming.token.store.jpa.TokenEntry">
        <attribute-override name="token">
            <column name="token" column-definition="BYTEA"></column>
        </attribute-override>
    </entity>
</entity-mappings>
